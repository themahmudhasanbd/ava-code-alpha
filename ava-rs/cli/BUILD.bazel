load("//:defs.bzl", "MACOS_WEBRTC_RUSTC_LINK_FLAGS", "ava_rust_crate")
load("//bazel/platforms:release_binaries.bzl", "multiplatform_binaries")
load("//bazel/rules:e2e_benchmark.bzl", "ava_e2e_benchmark")

ava_rust_crate(
    name = "cli",
    binaries_with_build_commit = ["ava"],
    crate_name = "ava_cli",
    extra_binaries = [
        "//ava-rs/bwrap:bwrap",
    ],
    rustc_flags_extra = MACOS_WEBRTC_RUSTC_LINK_FLAGS,
    test_data_extra = glob(["src/**/snapshots/**"]),
)

multiplatform_binaries(
    name = "ava",
)

ava_e2e_benchmark(
    name = "ava-help",
    binaries = [":ava"],
)
